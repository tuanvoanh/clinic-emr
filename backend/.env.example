PYTHONPATH=backend
# Security & JWT (MANDATORY: Generate a strong random key e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Superuser Credentials (MANDATORY: Set secure admin credentials before first launch)
FIRST_SUPERUSER_EMAIL=admin@clinic.com
FIRST_SUPERUSER_PASSWORD=change-this-admin-password
FIRST_SUPERUSER_FULL_NAME="Clinic Administrator"

# Database & Application
DATABASE_URL=sqlite:///./clinic.db
PROJECT_NAME="ClinicCare Mini EMR API"

# Public Setup Endpoint Control (Set to false after initial provisioning to lock setup)
ALLOW_SETUP_ENDPOINT=true
